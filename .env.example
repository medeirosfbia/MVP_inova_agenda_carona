# ============================================
# Copie este arquivo para .env e preencha com os valores do SEU projeto Supabase
#   Dashboard > Project Settings > API > Project URL / anon public
# O arquivo .env NUNCA vai para o git (está no .gitignore).
# Na Vercel, use estes MESMOS nomes de variáveis em:
#   Project > Settings > Environment Variables
# ============================================
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole_a_chave_anon_public_aqui
